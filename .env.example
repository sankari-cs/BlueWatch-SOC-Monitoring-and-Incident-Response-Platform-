# Copy to .env for local development. Do not commit .env or credentials.
BLUEWATCH_DATABASE_URL=sqlite:///bluewatch.sqlite3
BLUEWATCH_SECRET_KEY=
BLUEWATCH_ANALYST=local-analyst
BLUEWATCH_FAILED_AUTH_THRESHOLD=5
BLUEWATCH_FAILED_AUTH_WINDOW_MINUTES=10
BLUEWATCH_AUTH_SEQUENCE_WINDOW_MINUTES=15
BLUEWATCH_CORRELATION_WINDOW_MINUTES=60

# Optional Wazuh Indexer read-only search integration. Leave blank until configured.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEX_PATTERN=wazuh-alerts-*
WAZUH_CA_BUNDLE=
WAZUH_TIMEOUT_SECONDS=10
WAZUH_PAGE_SIZE=100
WAZUH_MAX_PAGES=10
